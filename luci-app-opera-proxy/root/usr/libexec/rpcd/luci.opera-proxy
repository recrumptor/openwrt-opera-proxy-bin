#!/bin/sh

. /usr/share/libubox/jshn.sh

CFG="opera-proxy"

known_instances() {
	uci -q show "$CFG" 2>/dev/null | sed -n "s/^${CFG}\.\([A-Za-z0-9_-]*\)=instance\$/\1/p"
}

is_known_instance() {
	local want="$1" i
	for i in $(known_instances); do
		[ "$i" = "$want" ] && return 0
	done
	return 1
}

svc_json() {
	ubus -S call service list "{\"name\":\"$CFG\"}" 2>/dev/null
}

instance_running() {
	# $1 = svc json, $2 = instance name -> echoes "1 <pid> <rss_kb>" or "0 0 0"
	local running pid rss
	running=$(echo "$1" | jsonfilter -e "@['$CFG'].instances['$2'].running" 2>/dev/null)
	pid=$(echo "$1" | jsonfilter -e "@['$CFG'].instances['$2'].pid" 2>/dev/null)
	if [ "$running" = "true" ] && [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
		rss=$(awk '/VmRSS/{print $2}' "/proc/$pid/status" 2>/dev/null)
		echo "1 $pid ${rss:-0}"
	else
		echo "0 0 0"
	fi
}

has_socks_mode() {
	# $1 = args string -> returns 0 (true) if -socks-mode token is present
	local tok
	for tok in $1; do
		[ "$tok" = "-socks-mode" ] && return 0
	done
	return 1
}
arg_value() {
	# extract the value that follows a flag inside an args string, e.g.
	# arg_value "-country" "-bind-address 1.2.3.4:8080 -country AS" -> AS
	local flag="$1" args="$2" prev val=""
	set -- $args
	for tok in "$@"; do
		if [ "$prev" = "$flag" ]; then
			val="$tok"
			break
		fi
		prev="$tok"
	done
	echo "$val"
}

method_get_instances() {
	local svc name enabled args running pid rss listen socks

	svc=$(svc_json)

	json_init
	json_add_array instances
	for name in $(known_instances); do
		config_get_bool enabled "$name" enabled 0 2>/dev/null
		enabled=$(uci -q get "$CFG.$name.enabled")
		args=$(uci -q get "$CFG.$name.args")
		set -- $(instance_running "$svc" "$name")
		running="$1"; pid="$2"; rss="$3"

		listen=$(arg_value "-bind-address" "$args")
		[ -n "$listen" ] || listen=$(arg_value "--bind-address" "$args")
		socks=0
		has_socks_mode "$args" && socks=1

		json_add_object ""
		json_add_string name "$name"
		json_add_boolean enabled "$([ "$enabled" = 1 ] && echo 1 || echo 0)"
		json_add_string args "$args"
		json_add_boolean running "$running"
		json_add_int pid "$pid"
		json_add_int rss_kb "$rss"
		json_add_string listen "$listen"
		json_add_boolean socks_mode "$socks"
		json_close_object
	done
	json_close_array
	json_dump
}

method_set_instance() {
	local name enabled args

	json_load "$(cat)"
	json_get_var name name
	json_get_var enabled enabled
	json_get_var args args

	if ! is_known_instance "$name"; then
		json_init
		json_add_boolean success 0
		json_add_string error "unknown instance"
		json_dump
		return
	fi

	uci set "$CFG.$name.enabled=$enabled"
	uci set "$CFG.$name.args=$args"
	uci commit "$CFG"

	/etc/init.d/opera-proxy reload >/dev/null 2>&1

	json_init
	json_add_boolean success 1
	json_dump
}

method_action() {
	local name action ok=1

	json_load "$(cat)"
	json_get_var name name
	json_get_var action action

	if ! is_known_instance "$name"; then
		json_init
		json_add_boolean success 0
		json_add_string error "unknown instance"
		json_dump
		return
	fi

	case "$action" in
		stop)
			ubus -S call service delete "{\"name\":\"$CFG\",\"instance\":\"$name\"}" >/dev/null 2>&1
			;;
		start)
			uci set "$CFG.$name.enabled=1"
			uci commit "$CFG"
			/etc/init.d/opera-proxy reload >/dev/null 2>&1
			;;
		restart)
			/etc/init.d/opera-proxy reload >/dev/null 2>&1
			;;
		*)
			ok=0
			;;
	esac

	json_init
	json_add_boolean success "$ok"
	json_dump
}

method_test_proxy() {
	local name args listen socks proxy_url code time

	json_load "$(cat)"
	json_get_var name name

	if ! is_known_instance "$name"; then
		json_init
		json_add_boolean success 0
		json_add_string error "unknown instance"
		json_dump
		return
	fi

	args=$(uci -q get "$CFG.$name.args")
	listen=$(arg_value "-bind-address" "$args")
	[ -n "$listen" ] || listen=$(arg_value "--bind-address" "$args")
	[ -n "$listen" ] || listen="127.0.0.1:18080"

	socks=0
	has_socks_mode "$args" && socks=1

	if [ "$socks" = 1 ]; then
		proxy_url="socks5h://$listen"
	else
		proxy_url="http://$listen"
	fi

	set -- $(curl -s -o /dev/null -m 10 -w '%{http_code} %{time_total}' \
		-x "$proxy_url" "https://www.google.com/generate_204" 2>/dev/null)
	code="$1"; time="$2"

	json_init
	if [ "$code" = "204" ] || [ "$code" = "200" ]; then
		json_add_boolean success 1
	else
		json_add_boolean success 0
	fi
	json_add_string http_code "${code:-0}"
	json_add_string time_total "${time:-0}"
	json_add_string proxy_url "$proxy_url"
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object "get_instances"
		json_close_object
		json_add_object "set_instance"
		json_add_string name ""
		json_add_string enabled ""
		json_add_string args ""
		json_close_object
		json_add_object "action"
		json_add_string name ""
		json_add_string action ""
		json_close_object
		json_add_object "test_proxy"
		json_add_string name ""
		json_close_object
		json_dump
		;;
	call)
		case "$2" in
			get_instances) method_get_instances ;;
			set_instance)  method_set_instance ;;
			action)        method_action ;;
			test_proxy)    method_test_proxy ;;
			*) echo '{}'; exit 1 ;;
		esac
		;;
esac
