{
	"luci-app-opera-proxy": {
		"description": "Grant access to the opera-proxy LuCI app",
		"read": {
			"ubus": {
				"luci.opera-proxy": [ "get_instances" ],
				"service": [ "list" ]
			},
			"uci": [ "opera-proxy" ]
		},
		"write": {
			"ubus": {
				"luci.opera-proxy": [ "set_instance", "action", "test_proxy" ],
				"service": [ "event" ]
			},
			"uci": [ "opera-proxy" ]
		}
	}
}
