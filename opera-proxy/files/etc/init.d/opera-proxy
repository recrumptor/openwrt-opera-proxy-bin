#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

CFG="opera-proxy"
PROG="/usr/bin/opera-proxy"

service_triggers() {
	procd_add_reload_trigger "$CFG"
}

# Called once per 'instance' section by config_foreach.
# Section name (default / Americas / Asia / ...) becomes the procd instance name,
# so each config block runs as its own independent process.
start_instance() {
	local section="$1"
	local enabled args

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get args "$section" args ''

	procd_open_instance "$section"
	procd_set_param command "$PROG"

	# 'args' is a plain space-separated CLI argument string, exactly as
	# opera-proxy expects it (e.g. "-country AM -socks-mode -bind-address 127.0.0.1:18082").
	# shellcheck disable=SC2086
	procd_append_param command $args

	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load "$CFG"
	config_foreach start_instance instance
}

stop_service() {
	return 0
}

reload_service() {
	# USE_PROCD services don't get a granular per-instance reload for free,
	# so a reload just restarts every enabled instance from scratch.
	stop
	start
}
